{
    "data": {
        "data_dir": "data/sen1floods11",
        "s1_dir": "data/sen1floods11/S1Hand",
        "label_dir": "data/sen1floods11/LabelHand",
        "seq_length": 3,
        "target_size": [256, 256],
        "split_ratio": [0.7, 0.15, 0.15],
        "num_workers": 2
    },
    "model": {
        "autoencoder_depth": 4,
        "autoencoder_channels": [16, 32, 64, 128],
        "dropout_rate": 0.1,
        "transformer_embed_dim": 512,
        "transformer_heads": 8,
        "transformer_hidden_dim": 512,
        "transformer_layers": 2
    },
    "training": {
        "autoencoder_epochs": 15,
        "autoencoder_lr": 1e-3,
        "temporal_epochs": 30,
        "temporal_lr": 1e-4,
        "batch_size": 16,
        "early_stopping_patience": 5,
        "seed": 42
    }
}
